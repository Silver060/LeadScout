# Copy this file to .env and fill in your values. NEVER commit .env to git.
ANTHROPIC_API_KEY=
MODEL_QUALITY=claude-sonnet-5
MODEL_TRIAGE=claude-haiku-4-5-20251001
BRAVE_API_KEY=
PORT=3100
TRACKER_URL=http://localhost:3100
EMAIL_ENABLED=true
REPORT_TO=becca@example.com
ALERT_TO=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Signal sources (both optional; strongly recommended) ---
# Free key: https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
# Offline folder containing regional goods operator licence CSV files.
# Replace the CSV files weekly, but keep data/olicence-snapshot.json.
OLICENCE_CSV_DIR=C:/path/to/olicence-csv
# Backwards-compatible fallback: current goods operator licence CSV from data.gov.uk
# (search "operator licence"). Used only when OLICENCE_CSV_DIR is blank.
OLICENCE_CSV_URL=
